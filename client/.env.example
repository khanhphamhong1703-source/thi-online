# Biến môi trường frontend (không bắt buộc khi chạy dev qua Vite proxy)
# Mặc định dùng cổng 5180 và proxy /api -> localhost:5050.
# Khi deploy tách domain, đặt URL API đầy đủ:
# VITE_API_URL=https://api.example.com/api
#
# Có thể đổi cổng dev và đích proxy:
# VITE_DEV_PORT=5180
# VITE_API_PROXY=http://localhost:5050
