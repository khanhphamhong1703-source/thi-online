# Sao chép thành .env.production và không commit file này.
# Chạy: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Bắt buộc đổi JWT_SECRET và SEED_ADMIN_PASSWORD; ứng dụng sẽ từ chối chạy
# production nếu vẫn dùng giá trị mẫu.
# Tạo secret: openssl rand -base64 48

HTTPS_PORT=443
CLIENT_URL=https://your-domain.com
CERTS_DIR=./certs

# Chỉ cần khi chạy Cloudflare Tunnel (--profile tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Bắt buộc: tối thiểu 32 ký tự.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FULLNAME=Quản trị viên
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_RESET_PASSWORD=false
