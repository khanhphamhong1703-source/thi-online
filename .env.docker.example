# Sao chép file này thành .env ở thư mục gốc trước khi chạy Docker Compose.
# docker compose sẽ đọc các biến này để thay thế trong docker-compose.yml.

HTTPS_PORT=8443
SERVER_PORT=5050
MONGO_PORT=27017
CLIENT_URL=https://localhost:8443
CERTS_DIR=./certs

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token
# Bắt buộc true khi chạy HTTPS.
COOKIE_SECURE=true
TRUST_PROXY=1

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_FULLNAME=Quản trị viên
SEED_ADMIN_EMAIL=admin@example.com
# true: cập nhật lại mật khẩu Admin mỗi lần container khởi động (phù hợp local).
SEED_ADMIN_RESET_PASSWORD=true
