# Sao chép file này thành .env ở thư mục gốc trước khi chạy Docker Compose.
# docker compose sẽ đọc các biến này để thay thế trong docker-compose.yml.
#
# Bắt buộc đổi JWT_SECRET và SEED_ADMIN_PASSWORD; ứng dụng sẽ từ chối chạy
# production nếu vẫn dùng giá trị mẫu.
# Tạo secret: openssl rand -base64 48

HTTPS_PORT=8443
SERVER_PORT=5050
MONGO_PORT=27017
CLIENT_URL=https://localhost:8443
# Origin phụ được phép gọi API (cách nhau dấu phẩy), ví dụ dev server Vite.
CORS_EXTRA_ORIGINS=http://localhost:5180
CERTS_DIR=./certs

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
# Bắt buộc true khi chạy HTTPS.
COOKIE_SECURE=true
TRUST_PROXY=1

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FULLNAME=Quản trị viên
SEED_ADMIN_EMAIL=admin@example.com
# Chỉ đặt true khi muốn đặt lại mật khẩu Admin ở local; production luôn dùng false.
SEED_ADMIN_RESET_PASSWORD=false
