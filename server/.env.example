# Chạy: cp .env.example .env và thay các giá trị bí mật
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5180
MONGODB_URI=mongodb://127.0.0.1:27017/thi_online?replicaSet=rs0

# Tối thiểu 32 ký tự, hãy tạo chuỗi ngẫu nhiên cho môi trường thật
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Access token ngắn hạn; refresh token dài hạn được lưu hash trong DB
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
# Đặt false khi chạy HTTP local; đặt true khi triển khai có HTTPS.
COOKIE_SECURE=false
# TRUST_PROXY=1

# Tài khoản Admin được tạo bởi `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FULLNAME=Quản trị viên
SEED_ADMIN_EMAIL=admin@example.com
# Chỉ đặt true khi muốn đặt lại mật khẩu Admin ở môi trường local.
SEED_ADMIN_RESET_PASSWORD=false
