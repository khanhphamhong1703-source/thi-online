generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  password     String
  fullName     String
  email        String?
  phone        String?
  role         String   @default("TEACHER")
  isActive     Boolean  @default(true)
  searchText   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  classes      Class[]  @relation("TeacherClasses")
  exams        Exam[]   @relation("TeacherExams")

  @@index([role, isActive])
  @@map("users")
}

model Class {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  classCode   String
  schoolYear  String
  description String?
  teacherId   String       @db.ObjectId
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  isArchived  Boolean      @default(false)
  searchText  String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  exams       Exam[]

  @@unique([teacherId, classCode])
  @@index([teacherId, isArchived])
  @@map("classes")
}

model Student {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  studentCode  String       @unique
  fullName     String
  dateOfBirth  DateTime
  phone        String?
  email        String?
  searchText   String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
  examAttempts ExamAttempt[]

  @@map("students")
}

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  classId   String   @db.ObjectId
  studentId String   @db.ObjectId
  class     Class    @relation(fields: [classId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("enrollments")
}

model Exam {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  subject           String
  description       String?
  accessCode        String        @unique
  durationMinutes   Int
  openAt            DateTime
  closeAt           DateTime
  status            String        @default("DRAFT")
  shuffleQuestions  Boolean       @default(false)
  shuffleOptions    Boolean       @default(false)
  maxAttempts       Int           @default(1)
  showScore         Boolean       @default(true)
  sectionTitles     Json?
  trueFalseScores   Json?
  searchText        String        @default("")
  publishedAt       DateTime?
  teacherId         String        @db.ObjectId
  classId           String?       @db.ObjectId
  classIds          String[]      @default([])
  teacher           User          @relation("TeacherExams", fields: [teacherId], references: [id])
  class             Class?        @relation(fields: [classId], references: [id])
  questions         Question[]
  attempts          ExamAttempt[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([teacherId, status])
  @@index([classId])
  @@index([status, openAt])
  @@map("exams")
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  content       String
  options       String[]
  correctOption Int
  statements    Json?
  correctText   String?
  points        Float    @default(1)
  section       String   @default("I")
  order         Int      @default(0)
  examId        String   @db.ObjectId
  exam          Exam     @relation(fields: [examId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([examId])
  @@map("questions")
}

model ExamAttempt {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  attemptNumber  Int
  status         String    @default("IN_PROGRESS")
  answers        Json?
  questionOrder  String[]
  optionOrders   Json?
  questionSnapshot Json?
  trueFalseScoresSnapshot Json?
  score          Float?
  maxScore       Float?
  correctCount   Int?
  exitCount      Int       @default(0)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  examId         String    @db.ObjectId
  studentId      String    @db.ObjectId
  exam           Exam      @relation(fields: [examId], references: [id])
  student        Student   @relation(fields: [studentId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([examId, studentId, attemptNumber])
  @@index([examId, status])
  @@index([studentId])
  @@map("exam_attempts")
}
